STEAM_USERNAME=
STEAM_PASSWORD=
# Only needed if you have a mobile authenticator shared_secret (enables auto 2FA codes).
STEAM_SHARED_SECRET=
STEAM_GUARD_AUTO=true
# No shared_secret? Run the bot locally once (STEAM_USERNAME/STEAM_PASSWORD set, real terminal
# so you can answer the Steam Guard prompt), copy the refresh token it prints, and set it here
# instead. Skips Steam Guard entirely on Railway. Valid for ~200 days.
STEAM_REFRESH_TOKEN=
GAME_IDS=440
